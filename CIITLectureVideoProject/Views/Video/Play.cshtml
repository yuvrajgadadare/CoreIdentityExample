@model DriveIndexViewModel

@{
    var videoId = ViewBag.VideoId;
    var videoName = ViewBag.VideoName ?? "Video Player";
}

<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>@videoName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />


    <style>

       

        .loader {
            display: none;
            text-align: center;
            margin-top: 10px;
        }

    </style>

</head>


<body>



    <div class="row">
        <div class="col-md-2">
            
            <a href="/Video/Index"
               class="btn btn-light back-btn">

                <i class="fa fa-arrow-left"></i>

                Back

            </a>
            <ul class="list-group">
                @foreach (var item in Model.Folders)
                {

                    <li class="list-group-item">

                        <a href="/Video/Folder/@item.Id" style="text-decoration:none">
                            @item.Name
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="col-md-8">


  <video id="videoPlayer"
               controls
               controlsList="nodownload" autoplay muted style="height:500px;width:100%">


            <source src="/Video/Stream/@videoId" type="video/mp4">


        </video>  
         


        <div class="loader" id="loader">

            <div class="spinner-border text-dark"></div>

            <p>Loading video...</p>

            </div>
        </div>
        <div class="col-md-2">

            <a href="/Video/Index"
               class="btn btn-light back-btn">

                <i class="fa fa-arrow-left"></i>

                Back

            </a>
            <ul class="list-group">
                @foreach (var item in Model.Videos)
                {

                    <li class="list-group-item">

                        <a href="/Video/Play/@item.Id" style="text-decoration:none">
                            @item.Name
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>


    <script>


        var video = document.getElementById("videoPlayer");

        var loader = document.getElementById("loader");


        video.addEventListener("waiting", function(){

        loader.style.display="block";

        });


        video.addEventListener("playing", function(){

        loader.style.display="none";

        });


    </script>



</body>

</html>