@using ERP_Models
@model EmployeeRegistrationModel
@{
    ViewData["Title"] = "AddEmployee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-6">
            <div class="card" id="dvprofile_new">
                <div class="card-header">
                    <h5 style="text-align:center">  User Registration  </h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label>First Name</label>
                             @Html.TextBoxFor(e=>e.FirstName,new {@class="form-control"})
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label>Last Name</label>
                                @Html.TextBoxFor(e => e.LastName, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                                <label>Gender</label><br />
                                @Html.RadioButtonFor(e => e.gender, "Male") <span>Male</span>
                                @Html.RadioButtonFor(e => e.gender, "Female") <span>Female</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                               Email Address
                                @Html.TextBoxFor(e => e.Email, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                Qualification
                                @Html.TextBoxFor(e => e.qualification, new { @class = "form-control" })
                            </div>
                            <div class="form-group">
                                Qualification
                                @Html.DropDownListFor(e => e.branch_id, ViewBag.branches as SelectList,"Select Branch", new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                                <label>Mobile Number</label>
                                @Html.TextBoxFor(e => e.mobile_number, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                                <label>Birth Date</label>
                                @Html.TextBoxFor(e => e.birth_date, new { @class = "form-control", @type = "date" })
                          
                        </div>
                        <div class="col-md-6 mb-3">
                            
                                <label>Joining Date</label>
                                @Html.TextBoxFor(e => e.joining_date, new { @class = "form-control", @type = "date" })
                             

                        </div>

                        <div class="col-md-12 mb-3">
                           
                                <label>Profile Photo</label>
                                <input type="file" name="Photo" class="form-control" />
                         

                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Register</button>
                    @* <a href="/account/register" class="btn btn-danger">Cancel</a> *@
                     <h4>@ViewBag.msg</h4>

                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div style="color:red">
                @Html.ValidationSummary()
            </div>
        </div>

    </div>

        </form>

 





