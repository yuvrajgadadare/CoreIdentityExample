@model IEnumerable<ERP_Models.BatchModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" style="font-size:smaller">
    <div class="row">
        <h5>Batches</h5>
    </div>
    <div class="row">
        @{
            int i = 1;
        }
        @foreach (var item in Model)
        {
            <div class="col-md-3">
                <div class="card mb-3 shadow-lg p-3 mb-5 bg-white rounded">
                    <div class="card-header">

                        <h5 style="text-align:center">@item.batch_name </h5>

                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tr>
                                <td style="text-align:right">Topic Name : </td>
                                <td>@item.topic_name</td>
                            </tr>
                            <tr>
                                <td style="text-align:right">Trainer Name : </td>
                                <td>@item.employee_name</td>
                            </tr>
                            <tr>
                                <td style="text-align:right">Batch Time : </td>
                                <td>@item.batch_time</td>

                            </tr>
                            <tr>
                                <td style="text-align:right">#Students : </td>
                                <td>@item.total_students</td>

                            </tr>
                            <tr>
                                <td style="text-align:right">#Leactures : </td>
                                <td>@item.total_leactures</td>

                            </tr>
                            <tr>
                                <td style="text-align:right">#Attended : </td>
                                <td>@item.attended_leatures</td>

                            </tr>
                            <tr>
                                <td style="text-align:right">#Remaining: </td>
                                <td>@item.remaining_leatures</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div class="progress">
                                        <div class="progress-bar bg-success" style="width:@item.completed_percentage%">
                                           @item.completed_percentage%
                                        </div>
                                    </div>
                                </td>

                            </tr>
                            <tr>
                                <td colspan="2" style="text-align:center">
                                    <a style="font-size:12px;" href="/Trainer/Batch/Details/@item.batch_id" class="btn btn-sm btn-primary">Batch Details</a>
                                </td>
                            </tr>



                        </table>
                    </div>
                </div>

            </div>
        }
    </div>
    <div class="card table-responsive">
    </div>
</div>

