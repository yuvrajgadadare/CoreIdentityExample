@model ERP_Models.StudentModel
@using ERP_Models
@{
    ViewData["Title"] = "Student Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var registration_id=0;
    function ViewChangeCourseModal(rid){
        registration_id=rid;
        $("#changecoursemodal").modal("show");
    }

    function ChangeCourse(){
        var st={
            "registration_id":registration_id,
            "discount":Number($("#txtdiscount").val()),
            "fee_id":$("#ddcourse").val()
        };
        $.ajax({
            url:'/Accountant/Student/ChangeStudentCourse',
            method:'post',
            data:st,
            success:function(resp){
            alert(resp);
            window.location.reload();
            }
        })
    }
</script>
@{
    List<BatchStudentModel> batches = (List<BatchStudentModel>)(ViewData["batches"]);
    List<StudentPaymentModel> payments = (List<StudentPaymentModel>)(ViewData["payments"]);
    List<StudentPaymentModel> pendingpayments = (List<StudentPaymentModel>)(ViewData["pendingpayments"]);
 

}

