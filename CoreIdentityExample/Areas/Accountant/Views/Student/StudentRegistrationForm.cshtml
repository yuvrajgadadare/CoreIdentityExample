
@{
    ViewData["Title"] = "StudentRegistrationForm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    input[type="text"], input[type="date"], input[type="file"], textarea, select {
        width:100%;
        font-size:small
    }
    label {
        font-size:small
    }
    h6{
        color:orangered
    }
    table,tr,td,th{
        font-size: small
    }
</style>


<div class="row">
    <div class="col-md-10">
        <div class="row">
            <div class="col-md-4" style="text-align:center">
                <h5>Student Registration Form</h5>
            </div>
            
            <div class="col-md-4 mb-3">
                <div>
                  
                </div>

            </div>
        </div>
       <div class="mb-3">
            <div class="card">
              
                <div class="card-body">
                 
                    <h6 class="card-title">Student Profile Details</h6>
                    <div class="row mt-3 mb-3">
                        <div class="col-md-3">
                            Select Branch
                            @Html.DropDownList("ddbranch", ViewBag.branches as SelectList, "Select Branch")

                        </div>
                        <div class="col-md-6"></div>

                        <div class="col-md-3">
                            Registration Date
                            <input type="date" id="txtregistration_date" />
                        </div>
                    </div>
                    <div class="row mb-3">

                        <div class="col-md-4">
                            <div class="">
                                <label>First Name</label>
                                <input type="text" id="txtstudent_name" />
                            </div>

                        </div>
                        <div class="col-md-4">
                            <div class="">
                                <label>Last Name</label>
                                <input type="text" id="txtlast_name" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="">
                                <label>Gender</label><br />
                                <input type="radio" id="gender_male" name="gender" value="Male" onchange="SelectGender('Male')" /> <span> Male</span>
                                <input type="radio" id="gender_female" name="gender" value="Female" onchange="SelectGender('Female')" /> <span> Female</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="">
                                <label>Birth Date</label>
                                <input type="date" id="txtbirth_date" />
                            </div>

                        </div>
                        <div class="col-md-3">
                            <div class="">
                                <label>Email Address</label>
                                <input type="text" id="txtemail_address" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="">
                                <label>Mobile Number</label>
                                <input type="text" id="txtmobile_number" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="">
                                <label>Whatsapp Number</label>
                                <input type="text" id="txtwhatsapp_number" />
                            </div>

                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="">
                                <label>Parent Name</label>
                                <input type="text" id="txtparent_name" />
                            </div>

                        </div>
                        <div class="col-md-3">
                            <div class="">
                                <label>Parent Number</label>
                                <input type="text" id="txtparent_number" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="">
                                <label>Adhar Card Number</label>
                                <input type="text" id="txtadhar_card_number" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label>Aadhar Card Photo</label>
                            <input type="file" id="txtaadhar_card_photo" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="">
                                <label>local Address</label>
                                <textarea id="txtlocal_address"></textarea>
                            </div>

                        </div>
                        <div class="col-md-6">
                            <div class="">
                                <label>Permanent Address</label>
                                <textarea id="txtpermanent_address"></textarea>
                            </div>
                        </div>

                    </div>
           <hr />
            
                    <h6 class="card-title">Student Qualification</h6>
                    <table class="table table-borderless">
                        <tr>
                            <td>
                                Qualification<br/>
                                @Html.DropDownList("qualification", ViewBag.qualifications as List<SelectListItem>, "Select Qualification")

                            </td>
                            <td>
                                <label>University</label><br/>
                                <input type="text" id="txtuniversity" />
                            </td>
                            <td>
                                <label>Passing Year</label><br />
                                <input type="text" id="txtpassing_year" />
                            </td>
                            <td>
                                <label>Medium</label><br />
                                <input type="text" id="txmedium" />
                            </td>
                            <td>
                                <label>Percentage</label><br />
                                <input type="text" id="txtpercentage" />
                            </td>
                            <td>
                                 <br />
                                <input type="button" id="btnadd" value="+" class="btn btn-primary" onclick="AddQualification()" />
                            </td>
                        </tr>
                    </table>
                    <hr/>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sr No</th>
                                <th>Qualification</th>
                                <th>University</th>
                                <th>Passing Year</th>
                                <th>Medium</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>
                        <tbody id="tblqualificationdata"></tbody>
                    </table>
                    <hr />

                    <h6 class="card-title">Registration Details</h6>

                    <div class="row">
                        <div class="row mb-3">

                        <div class="col-md-4">
                            <label>Select Course</label>
                                @Html.DropDownList("fee_id", ViewBag.courses as List<SelectListItem>, "Select Course",new{@onchange="GetCourseFees()"})
                        </div>
                        <div class="col-md-4">
                            <label>Fees Amount</label>
                                <input type="text" id="fees_amount" disabled />
                        </div>
                        <div class="col-md-4">
                            <label>GST</label>
                                <input type="text" id="gst" disabled />
                        </div>
                        </div>
                        <div class="row mb-3">

                        <div class="col-md-4">
                            <label>Total Fees</label>
                                <input type="text" id="total_fees" disabled />
                        </div>
                        <div class="col-md-4">
                            <label>Discount</label>
                            <input type="text" id="discount" onkeyup="Calculate()" />
                        </div>
                        <div class="col-md-4">
                            <label>Final Fees</label>
                            <input type="text" id="final_fees" disabled />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <hr/>
                        <h6 class="card-title">Payment Details</h6>

                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label>Payment Date</label>
                            <input type="date" id="txtpayment_date" />
                        </div>
                        <div class="col-md-3">
                            <label>Payment Amount</label>
                            <input type="text" id="txtpayment_amount" />
                        </div>
                        <div class="col-md-3">
                            <label>Payment Mode</label>
                            <input type="text" id="txtpayment_mode" />
                        </div>
                        <div class="col-md-3">
                            <label>Payment Description</label>
                            <input type="text" id="txtpayment_description" />
                        </div>
                    </div>
                </div>
            </div>
 
 </div>
 <div class="row">
            <input type="button" value="Submit" class="btn btn-primary" onclick="SubmitData()" />

 </div>
    </div>

</div>
<script>
    var gender="";
    var qualifications=[];
    const AddQualification=()=>{
        var qname=document.getElementById("qualification").value;
        var university=document.getElementById("txtuniversity").value;
        var year=document.getElementById("txtpassing_year").value;
        var medium=document.getElementById("txmedium").value;
        var per=document.getElementById("txtpercentage").value;
        var st={"qualification":qname,"passing_year":year,"university":university,"medium":medium,"percentage":per};
        qualifications.push(st);
        ClearData();
        DisplayQualifications();
    }
    const DisplayQualifications=()=>{
        var data="";
        qualifications.forEach(function(d,k){
            data+="<tr><td>"+(k+1)+"</td><td>"+d.qualification+"</td><td>"+d.university+"</td><td>"+d.passing_year+"</td><td>"+d.medium+"</td><td>"+d.percentage+"</td></tr>";
            
        })
        document.getElementById("tblqualificationdata").innerHTML=data;
    }
    const  GetCourseFees=async()=>{
       var fee_id=document.getElementById("fee_id").value;
       //alert(fee_id);
       const response=await fetch("/Accountant/Student/GetCourseFee/"+fee_id);
       const s=await response.json();
       var fees=Number(s.fees_amount);
       var gst=Number(s.gst);
       var total_fees=fees+((fees*gst)/100)
       document.getElementById("fees_amount").value=s.fees_amount;
       document.getElementById("gst").value=s.gst;
       document.getElementById("total_fees").value=total_fees;
       // document.getElementById("fees_amount").value=s.fees_amount;
       // document.getElementById("fees_amount").value=s.fees_amount;
    }

    const Calculate=()=>{
        var total=Number(document.getElementById("total_fees").value);
        var discount=Number(document.getElementById("discount").value);
        var final=total-discount;
        document.getElementById("final_fees").value=final;
    }
    const SelectGender=(g)=>{
            gender=g;
            //alert(gender);
    }
    const SubmitData=async()=>{
        payments=[];
        registrations=[];

        var pdate=document.getElementById("txtpayment_date").value;
        var pamount=document.getElementById("txtpayment_amount").value;
        var pmode=document.getElementById("txtpayment_mode").value;
        var pdesc=document.getElementById("txtpayment_description").value;
        var pt={"payment_date":pdate,"payment_amount":pamount,"payment_mode":pmode,"payment_description":pdesc};
        payments.push(pt);

        var fee_id=document.getElementById("fee_id").value;
        var discount=document.getElementById("discount").value;
        var regdate=document.getElementById("txtregistration_date").value;
        var rt={"fee_id":fee_id,"discount":discount,"registration_date":regdate};
        registrations.push(rt);
         

        var stud={
            "branch_id":document.getElementById("ddbranch").value,
            "registration_date":document.getElementById("txtregistration_date").value,
            "student_name":document.getElementById("txtstudent_name").value,
            "last_name":document.getElementById("txtlast_name").value,
            "gender":gender,
            "birth_date":document.getElementById("txtbirth_date").value,
            "mobile_number":document.getElementById("txtmobile_number").value,
            "whatsapp_number":document.getElementById("txtwhatsapp_number").value,
            "email_address":document.getElementById("txtemail_address").value,
            "parent_name":document.getElementById("txtparent_name").value,
            "parent_number":document.getElementById("txtparent_number").value,
            "local_address":document.getElementById("txtlocal_address").value,
            "permanent_address":document.getElementById("txtpermanent_address").value,
            "aadhar_card_number":document.getElementById("txtadhar_card_number").value,
           // "aadhar_card_photo":document.getElementById("txtaadhar_card_photo").value,
            "registrations":registrations,
            "payments":payments,
            "qualifications":qualifications
        }
        console.log(stud);
        const response=await fetch("/Accountant/Student/SubmitStudentRegistrationForm",{
            method:'post',
            body:JSON.stringify(stud),
            headers:{
                'content-type':'application/json'
            }
        })
        const st=await response.text();
        alert("Student Registered Successfully")
    }
    const ClearData=()=>{
       // document.getElementById("qualification").value="";
        document.getElementById("txtuniversity").value="";
        document.getElementById("txtpassing_year").value="";
        document.getElementById("txmedium").value="";
        document.getElementById("txtpercentage").value="";
    }
</script>