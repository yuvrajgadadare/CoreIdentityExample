@model IEnumerable<ERP_Models.StudentModel>
@using ERP_Models;
@{
    ViewData["Title"] = "Student Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/assets/vendor/simple-datatables/style.css" rel="stylesheet">
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<style>
    table{
    font-size:12px;
    }


    .form-control {
    font-size: 12px
    }

    label {
    /* font-size: 12px */
    }

    span {
    /* font-size: 12px */
    }

    input[type=text] {
    font-size: 12px
    }

</style>
 <style>
    table th {
        position: sticky;
        top: 0;
        z-index: 1;
