 </style>
@* @model ERPSystem_Models.StudentModel *@
    @* @{
        ViewData["Title"] = "RegistrationForm";
        Layout = "~/Areas/Accountant/Views/Shared/AccountantLayout.cshtml";
    } *@
<style>
    table {
        font-size: 12px;
    }


    .form-control {
        font-size: 12px
    }

    label {
        /* font-size: 12px */
    }

    span {
        /* font-size: 12px */
    }

    input[type=text] {
        font-size: 12px
    }
</style>
 <script>
     $(document).ready(function () {
         $("#btnadd").click(function () {
             $("#studentmodal").modal("show");
         })
     })

     function AddPaymentInstalllments(sid) {
         $.ajax({
            url: '/Accountant/Student/AddPaymentSchedule/'+sid,
            method:'post',
             success: function (resp) {
                 alert(resp);
             }
         })
     }
     var studentdata=[];
     const fetchStudents=async()=>{
        const response=await fetch("/Accountant/Student/GetAllStudents");
        const students=await response.json();
       studentdata=students;
        console.log(students);
        var data="";
        students.forEach(function(d,k){
        data+="<tr><td>"+(k+1)+"</td><td>"+d.registration_date.split("T")[0]+"</td><td>"+d.student_name+"</td><td>"+d.gender+"</td><td>"+d.birth_date.split("T")[0]+"</td><td>"+d.mobile_number+"</td><td>"+d.branch_name+"</td><td>"+d.permanent_identification_number+"</td><td><a href='/Accountant/Student/GetStudentWisedetails/"+d.student_id+"' class='btn btn-info btn-sm'>View Details</a> <input type='button' value='Change Course' class='btn btn-warning btn-sm' onclick='ChangeCourse("+d.student_id+")' /></td></tr>";
            })
            document.getElementById("tbldata").innerHTML=data;
         }
     fetchStudents();

     const filterStudents=()=>{
         var txt=document.getElementById("txtfilter").value;

         var students=studentdata.filter(e=>e.student_name.toLowerCase().includes(txt.toLowerCase()));
         console.log(studentdata);
         console.log(students);
        if(students.length>0){
        var data="";
       students.forEach(function(d,k){
       data+="<tr><td>"+(k+1)+"</td><td>"+d.registration_date.split("T")[0]+"</td><td>"+d.student_name+"</td><td>"+d.gender+"</td><td>"+d.birth_date.split("T")[0]+"</td><td>"+d.mobile_number+"</td><td>"+d.branch_name+"</td><td>"+d.permanent_identification_number+"</td><td><a href='/Accountant/Student/GetStudentWisedetails/"+d.student_id+"' class='btn btn-info btn-sm'>View Details</a> <input type='button' value='Change Course' class='btn btn-warning btn-sm' onclick='ChangeCourse("+d.student_id+")' /></td></tr>";
           })
           document.getElementById("tbldata").innerHTML=data;
           }
     }
 </script>
         <div class="row mb-3">
            <div class="col-md-2">
                <a href="/Accountant/Student/StudentRegistrationForm" class="btn btn-primary btn-sm">New Registration</a>
            </div>
    <div class="col-md-4">
        <input type="text" class="form-control" id="txtfilter" onkeyup="filterStudents()" placeholder="search student by name,mobile,qualification,course,email address,etc" />
    </div>
            <div class="col-md-4">
               <form method="post">
                    <div class="row">
                      <div class="col-md-8">
                            <select class="form-control" name="year">
                                <option selected disabled>Select Year</option>
                                @foreach(var d in ViewBag.years){
                                    <option value="@d">@d</option>
                                }
                            </select>
                    </div>
                      <div class="col-md-2">
                <input type="submit" value="Submit" class="btn btn-primary btn-sm" />
            </div>
                <div class="col-md-2">
                    <a href="/Accountant/Student/Index" class="btn btn-info btn-sm">Refresh</a>

                </div>
            </div>
            <div class="row">
                 <div class="col-md-12">
                     @if(ViewBag.result!=null)
                     {
                    <span> Admissions for year <b>@ViewBag.result</b></span>
                     }
            </div>
            </div>

               </form>
          
            </div>
            </div>


    
 
       
        <div class="row">
            <table  class="table datatable" style="font-size:small">
                <thead>
                    <tr>
                        <th style="width:auto">Sr No</th>
                <th style="width:auto">Registration Date</th>
                <th style="width:auto">Student Name</th>
                <th style="width:auto">Gender</th>
                <th style="width:auto" data-type="date" data-format="DD-MM-YYYY">Birth Date</th>
                <th style="width:auto">Mobile Number</th>
                <th style="width:auto">Branch</th>
                <th style="width:auto">Course</th>
                <th style="width:auto">PIN</th>
                <th style="width:auto">Action</th>
                    </tr>
                </thead>
                @if(Model.Count()>0)
                {
                <tbody id="tbldata">
                  @{
                        int i = 1;
                      //  List<StudentModel> lst = (List<StudentModel>)ViewData["students"];
                    }
                     
                    @foreach (var item in Model)
                    {


                        <tr>
                            <td>@i</td>
                            <td>@item.registration_date.ToShortDateString()</td>
                            <td>@item.student_name @item.last_name</td>
                            <td>@item.gender</td>
                            <td>@item.birth_date.ToShortDateString()</td>
                            <td>@item.mobile_number</td>
                            <td>@item.branch_name</td>

                            @if (item.registrations.Count() > 0)
                            {
                                RegistrationModel r = item.registrations.First();
                                <td>@r.course_name</td>
                            }
                            else
                            {
                                <td></td>
                            }
                            <td>@item.permanent_identification_number</td>
                            <td>
                                <a href="/Accountant/Student/GetStudentWisedetails/@item.student_id" class="btn btn-info btn-sm">View Details</a>
                                <input type='button' value='Change Course' class='btn btn-warning btn-sm' onclick='ChangeCourse(@item.student_id)' />
                            </td>
                        </tr>
                        i++;
                    } 
            </tbody>

        }
        else
        {
            <tbody>
                <tr>
                    <td colspan="10">
                        <h4 style="color:red;text-align:center">No students found</h4>
                    </td>
                </tr>
            </tbody>
        }
    </table>
        </div>
    
     
</div>
 