@using ERP_Models
@{
    List<BatchScheduleExamModel> exams = (List<BatchScheduleExamModel>)ViewData["exams"];
}


<div class="mb-3 shadow-lg p-3 mb-3 bg-white rounded">
    <div class="card">
        
        <div class="card-body">
            <div class="mb-2">
                <h4 style="text-align:center">Scheduled Exams</h4>
            </div>
             
            <table class="table">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Topic</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int j = 1;
                    }
                    @foreach (var item in exams)
                    {
                        <tr>
                            <td>@j</td>
                            <td> @item.topic_name</td>
                            <td>@item.exam_date.ToShortDateString()</td>
                        </tr>
                        j++;
                    }
                </tbody>
            </table>
           
        </div>
    </div>
</div>