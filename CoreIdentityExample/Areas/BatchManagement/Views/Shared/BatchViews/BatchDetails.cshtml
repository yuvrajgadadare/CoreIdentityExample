@using ERP_Models
@{
    BatchModel batch = (BatchModel)ViewData["batch"];
}
<div class="col-md-12">
    
    <div class="card mb-3 shadow-lg p-3 mb-5 bg-white rounded">
        <div class="card-header">

            <h5 style="text-align:center">Batch Detail</h5>

        </div>
        <div class="card-body">
            <table class="table table-borderless">
 
            <tr>
                <td style="text-align:right">Batch Name:</td>
                <td> <b>@batch.batch_name</b></td>
            </tr>
            <tr>
                <td style="text-align:right">Topic:</td>
                <td> <b>@batch.topic_name</b></td>
            </tr>
            <tr>
                <td style="text-align:right">Trainer: </td>
                <td><b>@batch.employee_name</b></td>
            </tr>
            <tr>
                <td style="text-align:right">Start Date:</td>
                <td> <b>@batch.start_date.ToShortDateString()</b></td>
            </tr>
            <tr>
                <td style ="text-align:right">Timing: </td>
                <td><b>@batch.batch_time</b></td>
            </tr>
            <tr>
                <td style="text-align:right">#Students: </td>
                <td><b>@batch.total_students</b></td>
            </tr>
                <tr>
                    <td style="text-align:right">#Leactures: </td>
                    <td><b>@batch.total_leactures</b></td>
                </tr>
                <tr>
                    <td style="text-align:right">#Attended: </td>
                    <td><b>@batch.attended_leatures</b></td>
                </tr>
                <tr>
                    <td style="text-align:right">#Remaining: </td>
                    <td><b>@batch.remaining_leatures</b></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width:@batch.completed_percentage%">
                                @batch.completed_percentage%
                            </div>
                        </div>
                    </td>

                </tr>
        </table>
        </div>
    </div>
</div>
 