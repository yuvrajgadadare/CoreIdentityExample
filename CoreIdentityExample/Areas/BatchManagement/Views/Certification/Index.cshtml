
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>

    const getBranchWiseStudents=async()=>{
        const branch_id=document.getElementById("branch_id").value;
        //alert(branch_id);
        const response=await fetch("/BatchManagement/Certification/GetBranchWiseStudents/"+branch_id);
        const students=await response.json();
        console.log(students);
        var data="<option selected disabled>Select Student</option>";
        students.forEach(function(d,k){
            data+="<option value="+d.student_id+">"+d.student_name+"</option>"
        })
        document.getElementById("registration_id").innerHTML=data;
    }
     const getStudentWiseExams=async()=>{
          document.getElementById("loading").setAttribute("hidden");
          try {
        const registration_id=document.getElementById("registration_id").value;
        //alert(branch_id);
        const response=await fetch("/BatchManagement/Certification/GetStudentExams/"+registration_id);
        const students=await response.json();
        console.log(students);
        var data="";
        students.forEach(function(d,k){
            if(d.status=="Submitted"){

            data+="<tr><td>"+(k+1)+"</td><td>"+d.topic_name+"</td><td>"+d.exam_date+"</td><td>"+d.start_time+"</td><td>"+d.end_time+"</td><td>"+d.status+"</td><td>"+d.total_questions+"</td><td>"+d.total_correct_questions+"</td><td>"+d.total_wrong_questions+"</td><td>"+d.percentage+"</td></tr>"
            }

        })
        document.getElementById("tbldata").innerHTML=data;
          } catch (error) {
      console.error("Fetch error:", error);
    } finally {
      document.getElementById("loading").style.display = "none"; // Hide spinner regardless of success/fail
    }
    }
</script>
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                     <table class="table table-borderless">
                         <tr>
                            <td>
                                Select Branch :
                                @Html.DropDownList("branch_id", ViewBag.branches, "Select Branch", new { @class = "form-control",@onchange="getBranchWiseStudents()" })
                            </td>
                             <td>
                                Select Student :
                                <select class="form-control" id="registration_id" onchange="getStudentWiseExams()">
                                    <option selected disabled>Select Student</option>
                                </select>
                             </td>
                         </tr>
                     </table>
                     
                </div>
            </div>
            <div class="d-flex justify-content-center">
                <div class="spinner-border" role="status">
                    <span class="sr-only" id="loading" hidden></span>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <hr />
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Exam Date</th>
                        <th>Topic Name</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Status</th>
                        <th>Total Questions</th>
                        <th>Correct Questions</th>
                        <th>Wrong Questions</th>
                        <th>Percentage</th>
                    </tr>
                </thead>
                <tbody id="tbldata"></tbody>
            </table>
        </div>
    </div>
</div>

