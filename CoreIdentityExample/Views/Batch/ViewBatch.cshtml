@using ERP_Models
@model IEnumerable<BatchScheduleModel>
@{
    ViewData["Title"] = "View Batch";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    int i = 1;
    BatchModel b = (BatchModel)ViewData["batch"];
}
<style>
    .form-control {
        font-size: 12px
    }

    label {
        font-size: 12px
    }

    span {
        font-size: 12px
    }

    input[type=text] {
        font-size: 12px
    }

    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: #055a6b;
        color:white;

    }
</style>
<style>
    table {
        font-size: 12px;
    }


    .form-control {
        font-size: 12px
    }

    label {
        font-size: 12px
    }

    span {
        font-size: 12px
    }

    input[type=text] {
        font-size: 12px
    }
</style>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<div class="container-fluid">
    <div class="row mb-4">
        <h5 class="text-center">@b.topic_name<b>(@b.batch_name)</b></h5>
    </div>
    <nav class="nav nav-pills nav-fill" style="background-color:lightgray">
        <a href="#batchDetails" class="nav-item nav-link active" data-bs-toggle="tab">Batch Details</a>
        <a href="#batchSchedule" class="nav-item nav-link" data-bs-toggle="tab">Batch Schedule</a>
        <a href="#batchexams" class="nav-item nav-link" data-bs-toggle="tab">Batch Exams</a>
    </nav>
    <div class="tab-content">
        <div class="tab-pane fade show active mt-3" id="batchDetails">
            <div class="shadow-lg p-3 mb-3 bg-white rounded">
            @Html.Partial("~/Areas/BatchManagement/Views/Shared/BatchViews/BatchDetails.cshtml")
            </div>
        </div>
        <div class="tab-pane fade mt-3" id="batchSchedule">
            <div class="shadow-lg p-3 mb-3 bg-white rounded">
            <div class="mb-2">
                <h4 style="text-align:center">Batch Schedule </h4>
            </div>
            <table class="table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Content Name</th>
                                    <th>Expected Date</th>
                                    <th>Expected Day</th>
                                    <th>Actual Date</th>
                                    <th>Actual Day</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.content_name</td>
                                        <td>@item.expected_date.ToShortDateString()</td>
                                        <td>@item.expected_date.DayOfWeek</td>
                                        @if (item.actual_date != null)
                                        {
                                            <td>@item.actual_date.Value.ToShortDateString()</td>
                                            <td>@item.actual_date.Value.DayOfWeek</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                            <td></td>
                                            @* <td>@item.actual_date.Value.DayOfWeek</td> *@
                                        }
                                        <td>@item.status</td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
            </div>
        </div>
        <div class="tab-pane fade mt-3" id="batchexams">
            @Html.Partial("~/Areas/BatchManagement/Views/Shared/BatchViews/BatchScheduleExams.cshtml")
        </div>
    </div>
</div>