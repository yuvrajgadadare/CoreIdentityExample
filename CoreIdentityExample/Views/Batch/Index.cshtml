@model IEnumerable<ERP_Models.BatchStudentModel>
@{
    ViewData["Title"] = "Batches";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
 
    int i = 1;
}
 
@if(Model.Count()==0)
{
    <div class="toast  bg-warning text-white fade show " style="width:50%">
        <div class="toast-header  bg-warning text-white">
            <strong class="me-auto"><i class="bi-gift-fill"></i> Sorry!</strong>
       
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            No Batch is allocated for you, contact to administrator 
        </div>
    </div>
}
else
{
    <table class="table" style="padding:2%;font-size:small" >
    <thead>
        <tr>
            <th>Sr No</th>
                <th>Batch </th>
                <th>Topic </th>
                <th>Start Date</th>
                <th>Timing</th>
                <th>Trainer </th>
                <th>#Leactured</th>
                <th>Attendance</th>
                <th>Action</th>

                
                
        </tr>
    </thead>
    <tbody>
            @foreach (var item in Model)
            {
                float per = item.attended_leactures * 100 / item.total_leactures;
                <tr>
                    <td>@i</td>
                    <td>@item.batch_name</td>
                    <td>@item.topic_name</td>
                    <td>@item.batch_time</td>

                    <td>@item.start_date.ToShortDateString()</td>
                    <td>@item.employee_name</td>
                    <td>@item.attended_leactures/@item.total_leactures</td>
                    <td> 
                        <span>@String.Format("{0:0.00}", @per) %</span>
                    </td>
                    <td>
                        <a href="/Batch/ViewBatch/@item.batch_id" style="background-color:#055a6b;color:white" class="btn btn-sm">View</a>
                        <a href="/Batch/Videos/@item.batch_id" style="background-color:#055a6b;color:white" class="btn btn-sm"> Videos</a>

                    </td>
                </tr>
                i++;
            }
        </tbody>
</table>    
}

