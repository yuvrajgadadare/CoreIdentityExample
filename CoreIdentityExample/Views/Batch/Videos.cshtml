@using ERP_Models
@model BatchPlayListModel
@{
    List<BatchStudentModel> lst = (List<BatchStudentModel>)ViewData["playlists"];
    ViewData["Title"] = "Videos";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}
<style>
    .bg-color {
        background-image: linear-gradient(to top, #fff1eb 0%, #ace0f9 100%);
    }
</style>
<div class="col-md-12">
    <div class="row" style="margin-left:0px;">
        <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-color">
            <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-dark min-vh-100">
                <a href="/" style="color:#055a6b;font-weight:bold" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto  text-decoration-none">
                    <span class="fs-5 d-none d-sm-inline">Batches</span>
                </a>
                <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                    @foreach (var item in lst)
                    {
                        <li class="nav-item">
                            <a href="/Batch/Videos/@item.batch_id" class="nav-link align-middle px-0   bold border-3" style="color:#055a6b;font-weight:bold">
                                <i class="fs-4 bi-house"></i> <span class="ms-1 d-none d-sm-inline">@item.PlayListTitle</span>
                            </a>
                        </li>
                    }
                </ul>
                <hr/>
            </div>
        </div>
        <div class="col py-3">
            <div class="row">
                <div class="col-md-10 mb-2">
                    <h6 style="text-align:center;color:#055a6b">@Model.playlist_title</h6>
                </div>

            <div class="row">

                @foreach (var video in Model.Videos)
                {
                    var videoUrl = $"https://youtube.com/watch?v={video.VideoId}";

                    <div class="col-md-10 mb-2">

                        @*   <a href="@videoUrl" target="_blank" rel="noopener noreferrer">
                                <img src="@video.ThumbnailUrl" class="card-img-top rounded shadow-sm" alt="@video.Title">
                            </a> *@
                        <!-- Wrap the title in the same 'a' tag -->
                        <a href="@videoUrl" target="_blank" rel="videoUrl" class="text-decoration-none text-dark">
                            <div class="">
                                    <div class="card-body img-thumbnail text-center" style="background-color:#055a6b">
                                    <span class="card-title text-white">@video.Title</span>
                                </div>
                            </div>
                        </a>

                    </div>
                }


            </div>
        </div>
    </div>
</div>