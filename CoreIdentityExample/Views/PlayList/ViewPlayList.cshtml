@using ERP_Models
@model PlaylistModel
@{
    ViewData["Title"] = "ViewPlayList";
    List<PlaylistModel> lst = (List<PlaylistModel>)ViewData["playlists"];
}

<h1>PlayLists</h1>
<div class="row">
    <div class="col-md-2">
        <ul class="list-group">
            @foreach (var item in lst)
            {
                <li class="list-group-item">
                    <a href="/PlayList/ViewPlayList/@item.PlayListId" class="nav-link text-primary">@item.PlayListTitle</a>
                </li>
            }
        </ul>
    </div>
    <div class="col-md-10">

        <h4>@Model.PlayListTitle</h4>
        <div class="row">

            @foreach (var video in Model.Videos)
            {
                var videoUrl = $"https://youtube.com/watch?v={video.VideoId}";

                <div class="col-md-3 mb-4">
                    <div class="card h-100 border-0">
                        <!-- Wrap the image in the 'a' tag -->
                        <a href="@videoUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@video.ThumbnailUrl" class="card-img-top rounded shadow-sm" alt="@video.Title">
                        </a>

                        <div class="card-body px-0">
                            <!-- Wrap the title in the same 'a' tag -->
                            <a href="@videoUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-dark">
                                <h6 class="card-title fw-bold">@video.Title</h6>
                            </a>
                        </div>
                    </div>
                </div>
            }
            }
        </div>

    </div>
</div>



