@model IEnumerable<ERP_Models.InterviewQuestionModel>
@using ERP_Models
@{
    ViewData["Title"] = "TopicWiseQuestions";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}
@{
    List<TopicModel> topics = (List<TopicModel>)ViewData["topics"];
 }
<style>
    a{
        text-decoration:none;
    }

    pre {
        white-space: pre-wrap; /* Allows for wrapping while preserving whitespace */
        font-family:'Bookman Old Style';
        font-size:small;
    }
</style>
<div class="">
    @*
<div class="row">
   <nav class="navbar navbar-expand-lg navbar-light bg-light fixed">
        <div class="container-fluid">
            <a href="#" class="navbar-brand">Topics</a>
