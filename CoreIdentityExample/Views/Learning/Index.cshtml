         @foreach(var item in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-lg p-3 mb-5 bg-white rounded">
                    <h5 class="nav-link" style="text-align:center;color:#13749d">@item.topic_name</h5>
                    <a href="/Learning/TopicWiseQuestions/@item.topic_id" class="list-group-item list-group-item-action">
                        <i class="bi-camera-fill"></i> Interview Questions
                        <span class="badge rounded-pill bg-primary float-end">@item.total_interview_question_count</span>
                    </a>
                    <a href="/Learning/TopicWisePrograms/@item.topic_id" class="list-group-item list-group-item-action">
                        <i class="bi-music-note-beamed"></i> Programs
                        <span class="badge rounded-pill bg-primary float-end">@item.total_program_count</span>
                    </a>
                    @if (@item.total_content_question_count >= 50)
                    {
                        <a href="/PracticeExam/Index/@item.topic_id" style="text-align:center;color:#e2285a;font-weight:bold" class="list-group-item list-group-item-action btn btn-primary btn-sm">
                            Practice Test  
                        </a>
                    }
                    else
                    {
                        <a    style="text-align:center;color:#e2285a;font-weight:bold" class="list-group-item list-group-item-action btn btn-primary btn-sm">
                           
                        </a>
                    }

                </div>
            </div>
        } 
    </div>
</div>

