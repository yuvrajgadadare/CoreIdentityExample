@using ERP_Models
@model GuestRegistrationFormModel
@{
    ViewData["Title"] = "GuestRegistrationForm";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        .divider:after,
        .divider:before {
            content: "";
            flex: 1;
            height: 1px;
            background: #eee;
        }

        .h-custom {
            height: calc(100% - 73px);
        }
        @Html.Raw("@") media (max-width: 450px) {
            .h-custom

        {
            height: 100%;
        }

        }
    </style>
</head>
<body>
    <section class="vh-100">
        <div class="container-fluid h-custom">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-md-6">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/draw2.webp"
                         class="img-fluid" alt="Sample image">
                </div>
                <div class="col-md-6">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <div class="divider d-flex align-items-center my-4">
                            <p class="text-center fw-bold mx-3 mb-0"><img src="~/assets/images/mainlogo.png" height="80" width="150" style="text-align:center" /></p>
                        </div>
                                <div class="card">
                                    <div class="card-header" style="text-align:center">
                                        <h5>Student Registration Form</h5>
                                    </div>
                                    <div class="card-body">

                                        <h6 class="card-title">Student Profile Details</h6>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    Select Branch <span class="text-danger">@Html.ValidationMessageFor(e=>e.branch_id)</span>
                                                    @Html.DropDownListFor(e => e.branch_id, ViewBag.branches as SelectList, "Select Branch", new { @class = "form-control" })

                                                </div>
                                            </div>


                                            <div class="col-md-6">
                                        Registration Date <span class="text-danger">@Html.ValidationMessageFor(e => e.registration_date)</span>
                                                @Html.TextBoxFor(e => e.registration_date, new { @class = "form-control", @type = "date" })
                                            </div>
                                        </div>
                                        <div class="row">

                                            <div class="col-md-4">
                                                <div class="mb-3">
                                            <label>First Name</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.student_name)</span>
                                                    @Html.TextBoxFor(e => e.student_name, new { @class = "form-control" })
                                                </div>

                                            </div>
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                            <label>Last Name</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.last_name)</span>
                                                    @Html.TextBoxFor(e => e.last_name, new { @class = "form-control" })

                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                            <label>Gender</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.gender)</span> <br />
                                            @Html.RadioButtonFor(e => e.gender, "Male") <span> Male</span>
                                                    @Html.RadioButtonFor(e => e.gender, "Female") <span> Female</span>

                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="">
                                            <label>Birth Date</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.birth_date)</span>
                                                    @Html.TextBoxFor(e => e.birth_date, new { @type = "date", @class = "form-control" })
                                                </div>

                                            </div>
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                            <label>Email Address</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.email_address)</span>
                                                    @Html.TextBoxFor(e => e.email_address, new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                            <label>Mobile Number</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.mobile_number)</span>
                                                    @Html.TextBoxFor(e => e.mobile_number, new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                            <label>Whatsapp Number</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.whatsapp_number)</span>
                                                    @Html.TextBoxFor(e => e.whatsapp_number, new { @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                        <label>Select Course</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.fee_id)</span>
                                                @Html.DropDownListFor(e => e.fee_id, ViewBag.courses as SelectList , "Select Course", new { @class = "form-control" })
                                            </div>

                                            <div class="col-md-4">
                                                <div class="mb-3">
                                            <label>local Address</label> <span class="text-danger">@Html.ValidationMessageFor(e => e.local_address)</span>
                                                    @Html.TextBoxFor(e => e.local_address, new { @class = "form-control" })
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="card-footer">
                                        <input type="submit" value="Submit" class="btn btn-primary" />
                                        <div style="color:green">@ViewBag.msg</div>
                                        <div style="color:red">@ViewBag.errormsg</div>
                                    </div>
                                </div>
                        
 
                    }
                    <p class="small fw-bold mt-2 pt-1 mb-0">
                       Already Registered? <a href="/Student/Login"
                                                  class="link-danger">Login as a Student</a>
                    </p>
                </div>
            </div>
        </div>
        <div class="d-flex flex-column flex-md-row text-center text-md-start justify-content-between py-4 px-4 px-xl-5 bg-primary">
            <!-- Copyright -->
            <div class="text-white col-md-4">
                Copyright  @Html.Raw("@")@DateTime.Now.Year. All rights reserved.
            </div>
            <!-- Copyright -->
            <!-- Right -->
            <div class="text-white  col-md-4">
                <a href="/Account/Login" style="color:white;text-decoration:none;">Employee Login</a>
            </div>
            <div class="text-white  col-md-4">
                <a href="/Enquiry/Index" style="color:white;text-decoration:none;">Enquiry Form</a>
            </div>
            <!-- Right -->
        </div>
    </section>
</body>
</html>

<style>
    input[type="text"], input[type="date"], input[type="file"], textarea, select {
        width: 100%;
        font-size: small
    }

    .form-control{
        width: 100%;
        font-size: small
    }
    label {
        font-size: small
    }

    h6 {
        color: orangered
    }

    table, tr, td, th {
        font-size: small
    }
</style>

