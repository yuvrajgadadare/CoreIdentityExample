<div class="row">
    <h5>Course Name : @reg.course_name</h5>
    <div>
        @{
            i = 1;
        }
        @foreach (var topic in rsmodel.Topics)
    {
            
                <div class="card shadow-lg p-3 bg-white rounded mb-3">

                @if(topic.batch.batch_id!=0)
                {
                        <table class="table table-borderless" style="background-color:007CC3">
                        <tr style="color:white;">
                            <td>@topic.topic_name <span> - @topic.batch.batch_name </span></td>
                            <td> @topic.batch.completed_percentage<span>%</span> completed </td>
                            <td> @topic.batch.total_leactures Leactures </td>
                            <td> @topic.batch.attended_leatures Attended </td>
                            <td>@topic.batch.remaining_leatures Remaining </td>
                        </tr>
                    </table>
                }
                else
                {
                    <h6>@topic.topic_name -<span style="color:orange"> No Batch Allocated </span></h6>

                }
                <table class="table table-bordered" style="font-size:small">
                    <thead>
                        <tr>
                            <th style="width:5%">Sr No</th>
                            <th style="width:55%">Content</th>
                            <th style="width:15%">Expected Date</th>
                            <th style="width:15%">Actual Date</th>
                            <th style="width:10%">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var content in topic.contents)
                        {
                            string color = "";
                            if (content.attendance != null && content.attendance.ToLower() == "present")
                            {
                                color = "green";
                            }
                            else if (content.attendance != null && content.attendance.ToLower() == "absent")
                            {
                                color = "red";
                            }

                            <tr style="background-color:@color">
                                <td>@i</td>
                                <td>@content.content_name</td>
                                <td>@content.expected_date.DayOfWeek, @content.expected_date.ToShortDateString()</td>

                                <td>
                                    @if (content.actual_date != null)
                                    {
                                        <span>@content.actual_date.Value.ToShortDateString()</span>
                                    }
                                    else
                                    {
                                        <span>Not Yet Conducted</span>
                                    }
                                </td>
                                <td>@content.attendance</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
                </div>

       
    }
    </div>

    </div>
</div>