                            <td><b>Fees Paid</b> :   @reg.paid_amount</td>

                            <td><b>Fees Remaining :</b>   @reg.remaining_amount</td>
                            </tr>
                        <tr>
                            <td><b>Fees Status</b> :  @reg.fees_status</td>
                        </tr>
                       </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
            <h6>Payment History</h6>

                <div class="card mb-3 shadow-lg mb-5 bg-color rounded" style="height:250px;overflow-y:scroll;overflow-x:hidden;scrollbar-width:thin;">
                    <div class="">
                        <table class="table table-bordered" style="font-size:small">
                            <thead>
                                <tr>
                                    <th>Sr No</th>
                                    <th>Payment Date</th>
                                    <th>Payment Amount</th>
                                    <th>Payment Mode</th>

                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                    float amount = 0;
                                }
                                @foreach (var item in payments)
                                {
                                    amount += item.payment_amount;
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.payment_date.ToShortDateString()</td>
                                        <td>@item.payment_amount</td>
                                        <td>@item.payment_mode</td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="text-align:right">Total Paid Till Date : </td>
                                    <td>@amount</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

            </div>

        </div>
 
        <div class="row bg-white">
        <div class="col-md-6">
            <h6>Batches</h6>

            <div class="row">
           
           @foreach(var item in batches)
        {

            float per = item.attended_leactures * 100 / item.total_leactures;
           
                        <div class="col-md-6">
                            <div class="card mb-3 shadow-lg bg-color p-3 mb-5  rounded ">
                                <div class="card-body">
                                    <div class="mb-3">
                                        <div class="row" style="font-size:small">
                                            <div class="col-md-6 mb-3">
                                                <span>@item.topic_name <span> (@item.batch_name)</span></span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <span> @item.employee_name </span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <span>@item.start_date.ToShortDateString()</span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <span>@item.batch_time</span>

                                            </div>
                                        </div>

                                    </div>
                                    <div class="mb-3">
                                        <label>@item.attended_leactures / @item.total_leactures</label>
                                        <div class="progress" style="background-color:white">
                                            <div class="progress-bar progress-bar-striped" style="width: @per%;">
                                                @per%
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12" style="text-align:right">
                                            <button onclick="ViewAttendance(@item.batch_id,@item.registration_id)" class="btn btn-warning btn-sm">View Attendance</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
         
        }


            </div>
        </div>
        <div class="col-md-6">
            <h6>Scheduled Exams</h6>

            <div class="card shadow-lg bg-color rounded" style="height:250px;overflow-y:scroll;overflow-x:hidden;scrollbar-width:thin;">


                <div class="card-body">
                    <table class="table table-hover  bg-color " style="font-size:small">
                        <thead>
                            <tr>
                                <th>Sr No</th>
                                <th>Topic Name</th>
                                <th>Exam Date</th>
                                <th>Exam Time</th>
                                <th>Status</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                i = 1;
                            }
                            @foreach (var item in scheduledexams)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@item.exam_date.ToShortDateString()</td>
                                    <td>@item.start_time.ToLongTimeString()</td>
                                    <td>@item.topic_name</td>

                                    @if (item.is_attended == 1)
                                    {
                                        <td>
                                            <span>Attended</span>
                                        </td>
                                        @* <td><a href="/BatchExam/ViewBatchExam/@item.exam_id" class="btn btn-dark btn-sm">View Exam</a></td> *@


                                    }
                                    else
                                    {
                                        <td>
                                            <span>Not Attended</span>
                                        </td>
                                        @* <td><a href="/BatchExam/Index/@item.exam_id" class="btn btn-warning btn-sm">Start Exam</a></td> *@

                                    }


                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
