@using ERP_Models
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}
<style>
    .bg-color{
        background-image: linear-gradient(to top, #fff1eb 0%, #ace0f9 100%);
    }
     
</style>

<script>
    function ViewAttendance(bid, rid) {
        var apiurl = "/dashboard/GetBatchWiseStudentAtendance?batch_id=" + bid + "&registration_id=" + rid;
        var totalleactures = 0, totalpresent = 0, totalabsent = 0;
        $.ajax({
            url: apiurl,
            method: 'get',
            success: function (resp) {
                $("#tblattendacedata").empty();
                totalleactures = resp.length;

                $.each(resp, function (i, d) {
                    var color = "";
                    var classname="";
                    if (d.is_present == 1) {
                        color = "green";
                        classname="table-success";
                        totalpresent = Number(totalpresent) + 1;
                    }
                    else {
                        color = "red";
                        classname="table-danger";

                        totalabsent = Number(totalabsent) + 1;
                    }
                    $("#tblattendacedata").append("<tr class="+classname+"><td>" + (i + 1) + "</td><td>" + d.content_name + "</td><td>" + d.expected_date + "</td><td>" + d.actual_date + "</td><td  style='color:" + color + "'>" + d.attendance + "</td></tr>");
                })
                var per = totalpresent * 100 / totalleactures;
                $("#tblattendance").html("<tr><td style='text-align:right'>Attendance:</td><td>" + per.toFixed(2) + "%</td></tr><tr><td style='text-align:right'>Total Leactures :</td><td> <b>" + totalleactures + "</b></td></tr><tr class='table-success'><td style='text-align:right'>Present Days : </td><td><b>" + totalpresent + "</b></td></tr><tr  class='table-danger'><td  style='text-align:right'>Absent Days :</td><td> <b>" + totalabsent + "</b></td></tr>");
            }
        })
        $("#attendancemodel").modal("show");
    }
</script>
@{
    RegistrationModel reg = (RegistrationModel)ViewData["registration"];
    List<BatchStudentModel> batches = (List<BatchStudentModel>)ViewData["batches"];
    List<StudentPaymentModel> payments = (List<StudentPaymentModel>)ViewData["payments"];
    List<TopicModel> topics = (List<TopicModel>)ViewData["topics"];
    RegistrationCourseScheduleModel rsmodel = (RegistrationCourseScheduleModel)ViewData["schedule"];
    List<BatchExamModel> scheduledexams = (List<BatchExamModel>)ViewData["scheduledexams"];
}
<div class="container-fluid">
        <div class="row bg-white">

