                    <div class="">
                        <table class="table table-bordered" style="font-size:small">
                           <tr>
                            <td><b>Course</b> :   @reg.course_name</td>

                            <td><b>Registration Date</b> :   @reg.registration_date.ToShortDateString()</td>
                            </tr>
                            <tr>
                            <td><b>Final Fees </b>  @reg.final_fees_amount</td>

                            <td><b>Student Status</b> :   @reg.current_status</td>
                            </tr>
                           
