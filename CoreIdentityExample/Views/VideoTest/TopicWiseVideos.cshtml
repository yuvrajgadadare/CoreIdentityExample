@model ERP_Models.TopicModel
@using ERP_Models
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    List<TopicModel> topics = (List<TopicModel>)ViewData["topics"];
}

<div class="container-fluid">

    <div class="row" style="margin-top:2%">
        <div class="col-md-2">
            <ul class="list-group">


                @foreach (var item in topics)
                {
                    if (item.folder_id != null && item.folder_id != "")
                    {
                        <li class="list-group-item">
                            <a href="/VideoTest/TopicWiseVideos/@item.topic_id">@item.topic_name</a>
                        </li>
                    }
                    else
                    {
                        <li class="list-group-item">
                            <a>@item.topic_name</a>
                        </li>
                    }
                }
            </ul>
        </div>
        <div class="col-md-7 text-bg-light">
            <iframe src="@ViewBag.folder/@ViewBag.video_file_id/preview" style="width:100%;height:500px;" allow="autoplay" allowfullscreen="allowfullscreen" frameborder="0" seamless="" sandbox="allow-same-origin allow-scripts"></iframe>

        </div>
        <div class="col-md-3">
             
                <div class="row mb-3">
                    <h4>@Model.topic_name</h4>
                    @if(Model.videos!=null){
                    <ul class="list-group">
                        
                        @foreach (var v in Model.videos)
                        {
                            <li class="list-group-item mb-3">

                                <a href="/VideoTest/Play?id=@v.video_file_id&topic_id=@v.topic_id" style="text-decoration:none">@v.video_title</a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <h5 style="color:red">No Video</h5>
                }
            </div>
            
        </div>
    </div>
</div>

